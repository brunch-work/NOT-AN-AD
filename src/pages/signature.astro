---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="subgrid">
    <div class="signature">
      <html lang="en">
        <head>
          <title>Louise Astorino email signature</title>
        </head>
        <body>
          <table
            width="100%"
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="
                font-size: 13px;
                line-height: 120%;
                grid-column: 1/-1;
              "
          >
            <tr>
              <td style="padding-bottom: 10px">
                <div>
                  <img
                    src="https://notanad.us/images/NOTANAD_MONOGRAM@4x.png"
                    alt="NOT AN AD Monogram"
                    style="width: 22px; height: 14px; object-fit: contain"
                  />
                </div>
              </td>
              <tr></tr>
              <tr>
                <td>
                  <p style="margin: 0; padding: 0; color: #000">
                    Louise Astorino
                  </p>
                </td>
              </tr>
              <tr>
                <td>
                  <p
                    style="
                      padding-bottom: 16px;
                      padding-top: 3px;
                      margin: 0;
                      color: #000;
                    "
                  >
                    [Co-founder & Art Director]
                  </p>
                </td>
              </tr>
              <tr>
                <td>
                  <a href="https://notanad.us">
                    <img
                      src="https://notanad.us/images/NOTANAD_LOGO@4x.png"
                      alt="NOT AN AD Logo"
                      style="width: 84px;"
                    />
                  </a>
                </td>
              </tr>
            </tr>
          </table>
        </body>
      </html>
    </div>
  </div>
</Layout>
